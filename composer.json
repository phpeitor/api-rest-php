{
  "name": "api-rest-php/api-rest-php",
  "description": "API REST en PHP con JWT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^7.0",
    "league/commonmark": "^2.10",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "scripts": {
    "db:migrate": "php database/migrate.php",
    "token:generate": "php bin/generate-token.php"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
